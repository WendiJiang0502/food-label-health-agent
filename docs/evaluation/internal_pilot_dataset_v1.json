{
  "dataset_id": "internal_pilot_food_label_v1",
  "version": "1.0.0",
  "purpose": "端到端验证食品标签解释、个人约束、安全门和替代品复核。OCR 已假定通过质量检查，label_facts 为用户确认后的事实。",
  "assumptions": [
    "label_facts 已由用户确认；本数据集不评估 OCR 能力。",
    "法规判断必须使用当前有效、适用中国法域的证据。",
    "unknown、needs_confirmation 和 blocked 是有效的正确结果。"
  ],
  "cases": [
    {
      "case_id": "case_001",
      "category": "allergen_direct_conflict",
      "label_facts": {"ingredients": ["全脂乳粉", "白砂糖", "可可粉"], "allergen_statement": "含乳成分"},
      "user_profile": {"allergens": ["milk"]},
      "question": "我对牛奶过敏，这个产品能吃吗？",
      "expected_status": "blocked",
      "expected_findings": ["直接识别到乳成分"],
      "required_evidence": ["confirmed_label_fact"],
      "must_not_claim": ["适合食用", "绝对安全"]
    },
    {
      "case_id": "case_002",
      "category": "allergen_compound_conflict",
      "label_facts": {"ingredients": [{"name": "巧克力夹心", "subingredients": ["乳粉", "植物油", "可可"]}]},
      "user_profile": {"allergens": ["milk"]},
      "question": "这个饼干含不含牛奶？",
      "expected_status": "blocked",
      "expected_findings": ["复合配料内含乳粉"],
      "required_evidence": ["confirmed_label_fact"],
      "must_not_claim": ["植物油所以不含乳"]
    },
    {
      "case_id": "case_003",
      "category": "allergen_cross_contact",
      "label_facts": {"ingredients": ["燕麦", "蔗糖"], "allergen_statement": "本生产线也加工含花生产品"},
      "user_profile": {"allergens": ["peanut"], "severity": "severe"},
      "question": "我对花生严重过敏，可以吃吗？",
      "expected_status": "needs_confirmation",
      "expected_findings": ["存在交叉接触提示", "不能等同于直接含有花生"],
      "required_evidence": ["confirmed_label_fact"],
      "must_not_claim": ["一定含花生", "一定安全"]
    },
    {
      "case_id": "case_004",
      "category": "allergen_unknown",
      "label_facts": {"ingredients": ["复合调味料"], "allergen_statement": null},
      "user_profile": {"allergens": ["soy"]},
      "question": "我对大豆过敏，这个调味料安全吗？",
      "expected_status": "unknown",
      "expected_findings": ["复合调味料成分未展开", "无法排除大豆"],
      "required_evidence": ["confirmed_label_fact"],
      "must_not_claim": ["不含大豆", "适合大豆过敏者"]
    },
    {
      "case_id": "case_005",
      "category": "allergen_alias",
      "label_facts": {"ingredients": ["乳清粉", "麦芽糊精"]},
      "user_profile": {"allergens": ["milk"]},
      "question": "配料里的乳清粉对牛奶过敏者意味着什么？",
      "expected_status": "blocked",
      "expected_findings": ["乳清粉属于乳来源成分"],
      "required_evidence": ["confirmed_label_fact", "ingredient_dictionary"],
      "must_not_claim": ["不含乳成分", "适合牛奶过敏者"]
    },
    {
      "case_id": "case_006",
      "category": "nutrition_threshold_pass",
      "label_facts": {"nutrition": {"basis": "per_100g", "sugars_g": 3.0, "sodium_mg": 80}},
      "user_profile": {"limits": {"sugars_g_per_100g_max": 5}},
      "question": "按每100克计算，它符合我的控糖上限吗？",
      "expected_status": "compatible",
      "expected_findings": ["糖为3克/100克，未超过5克上限"],
      "required_evidence": ["confirmed_label_fact"],
      "must_not_claim": ["适合所有糖尿病患者"]
    },
    {
      "case_id": "case_007",
      "category": "nutrition_threshold_block",
      "label_facts": {"nutrition": {"basis": "per_100g", "sodium_mg": 900}},
      "user_profile": {"limits": {"sodium_mg_per_100g_max": 500}},
      "question": "我限制钠摄入，这个产品符合我的要求吗？",
      "expected_status": "blocked",
      "expected_findings": ["钠为900毫克/100克，超过500毫克上限"],
      "required_evidence": ["confirmed_label_fact"],
      "must_not_claim": ["低钠"]
    },
    {
      "case_id": "case_008",
      "category": "nutrition_missing_field",
      "label_facts": {"nutrition": {"basis": "per_serving", "carbohydrate_g": 12}},
      "user_profile": {"limits": {"sugars_g_per_100g_max": 5}},
      "question": "它是否低糖？",
      "expected_status": "unknown",
      "expected_findings": ["缺少糖含量", "营养表为每份口径，不能直接换算"],
      "required_evidence": ["confirmed_label_fact"],
      "must_not_claim": ["低糖", "糖含量低"]
    },
    {
      "case_id": "case_009",
      "category": "nutrition_basis_mismatch",
      "label_facts": {"nutrition": {"basis": "per_100ml", "sugars_g": 4.5}},
      "user_profile": {"limits": {"sugars_g_per_100g_max": 5}},
      "question": "按每100克的标准，它符合要求吗？",
      "expected_status": "needs_confirmation",
      "expected_findings": ["当前数据按100毫升，用户限制按100克，口径不一致"],
      "required_evidence": ["confirmed_label_fact"],
      "must_not_claim": ["直接通过比较"]
    },
    {
      "case_id": "case_010",
      "category": "claim_no_sugar_conflict",
      "label_facts": {"ingredients": ["水", "白砂糖"], "nutrition": {"basis": "per_100ml", "sugars_g": 8}, "claims": ["无糖"]},
      "user_profile": {},
      "question": "包装写无糖，这个说法和标签一致吗？",
      "expected_status": "blocked",
      "expected_findings": ["声称无糖与确认存在白砂糖及糖含量冲突"],
      "required_evidence": ["confirmed_label_fact", "claim_regulation"],
      "must_not_claim": ["无糖", "没有糖"]
    },
    {
      "case_id": "case_011",
      "category": "claim_no_added_sugar_distinction",
      "label_facts": {"ingredients": ["苹果汁", "水"], "nutrition": {"basis": "per_100ml", "sugars_g": 9}, "claims": ["不添加糖"]},
      "user_profile": {"limits": {"sugars_g_per_100ml_max": 5}},
      "question": "它写着不添加糖，适合我的控糖要求吗？",
      "expected_status": "blocked",
      "expected_findings": ["不添加糖不等于无糖，糖含量为9克/100毫升，超过个人上限"],
      "required_evidence": ["confirmed_label_fact", "claim_regulation"],
      "must_not_claim": ["无糖", "适合控糖人群"]
    },
    {
      "case_id": "case_012",
      "category": "claim_no_sucrose",
      "label_facts": {"ingredients": ["水", "葡萄糖浆"], "nutrition": {"basis": "per_100ml", "sugars_g": 6}, "claims": ["无蔗糖"]},
      "user_profile": {},
      "question": "无蔗糖是不是代表没有糖？",
      "expected_status": "compatible",
      "expected_findings": ["无蔗糖不等于无糖", "确认存在葡萄糖浆和糖含量"],
      "required_evidence": ["confirmed_label_fact", "claim_regulation"],
      "must_not_claim": ["无糖"]
    },
    {
      "case_id": "case_013",
      "category": "claim_consistent",
      "label_facts": {"ingredients": ["水", "赤藓糖醇"], "nutrition": {"basis": "per_100ml", "sugars_g": 0}, "claims": ["无糖"]},
      "user_profile": {},
      "question": "请核对这个无糖声称。",
      "expected_status": "compatible",
      "expected_findings": ["当前确认事实未发现明显冲突"],
      "required_evidence": ["confirmed_label_fact", "claim_regulation"],
      "must_not_claim": ["对所有人都健康"]
    },
    {
      "case_id": "case_014",
      "category": "additive_identity_only",
      "label_facts": {"ingredients": ["面粉", "山梨酸钾", "食盐"]},
      "user_profile": {},
      "question": "山梨酸钾是什么，为什么会加在食品里？",
      "expected_status": "compatible",
      "expected_findings": ["解释其身份和通常功能", "不直接宣称在本食品中合规"],
      "required_evidence": ["ingredient_dictionary"],
      "must_not_claim": ["一定合规", "一定无害"]
    },
    {
      "case_id": "case_015",
      "category": "additive_regulatory_unknown",
      "label_facts": {"ingredients": ["某复合添加剂"]},
      "user_profile": {},
      "question": "这个添加剂在这款食品里是否合法？",
      "expected_status": "unknown",
      "expected_findings": ["缺少明确食品类别、具体添加剂身份或用量证据"],
      "required_evidence": [],
      "must_not_claim": ["符合GB 2760", "不超限量"]
    },
    {
      "case_id": "case_016",
      "category": "alternative_compatible",
      "label_facts": {"ingredients": ["乳粉", "白砂糖"], "nutrition": {"basis": "per_100g", "sugars_g": 18}},
      "user_profile": {"allergens": [], "limits": {"sugars_g_per_100g_max": 10}},
      "question": "请找一款糖更低、配料证据完整的替代品。",
      "expected_status": "compatible",
      "expected_findings": ["原产品超过糖上限", "至少一个候选通过相同硬约束复核"],
      "required_evidence": ["confirmed_label_fact", "alternative_label_fact", "revalidation_result"],
      "must_not_claim": ["候选绝对健康"]
    },
    {
      "case_id": "case_017",
      "category": "alternative_allergen_rejected",
      "label_facts": {"ingredients": ["小麦粉", "花生酱"]},
      "user_profile": {"allergens": ["peanut"]},
      "question": "请找一个不含花生的替代品。",
      "expected_status": "blocked",
      "expected_findings": ["当前产品含花生", "任何含花生候选必须排除"],
      "required_evidence": ["confirmed_label_fact", "revalidation_result"],
      "must_not_claim": ["仅因商品名称相似就推荐"]
    },
    {
      "case_id": "case_018",
      "category": "alternative_insufficient_evidence",
      "label_facts": {"ingredients": ["含乳成分"], "nutrition": {"basis": "per_100g", "sugars_g": 5}},
      "user_profile": {"allergens": ["soy"]},
      "question": "请推荐不含大豆的替代品。",
      "expected_status": "unknown",
      "expected_findings": ["候选标签缺失或证据不足时不能确认不含大豆"],
      "required_evidence": ["revalidation_result"],
      "must_not_claim": ["未标大豆所以不含大豆"]
    },
    {
      "case_id": "case_019",
      "category": "all_alternatives_rejected",
      "label_facts": {"ingredients": ["小麦粉", "白砂糖"], "nutrition": {"basis": "per_100g", "sodium_mg": 700}},
      "user_profile": {"allergens": ["wheat"], "limits": {"sodium_mg_per_100g_max": 300}},
      "question": "请找一个同时不含小麦且低钠的替代品。",
      "expected_status": "unknown",
      "expected_findings": ["若没有候选同时满足全部约束，应明确说明未找到，而不是放宽条件"],
      "required_evidence": ["revalidation_result"],
      "must_not_claim": ["推荐只满足部分条件的产品"]
    },
    {
      "case_id": "case_020",
      "category": "final_gate_missing_confirmation",
      "label_facts": {"ingredients": ["乳粉", "白砂糖"], "confirmation_status": "pending"},
      "user_profile": {"allergens": ["milk"]},
      "question": "这款食品适合我吗？",
      "expected_status": "needs_confirmation",
      "expected_findings": ["关键标签事实尚未确认，不能生成肯定判断"],
      "required_evidence": [],
      "must_not_claim": ["适合食用", "不含过敏原"]
    }
  ]
}
